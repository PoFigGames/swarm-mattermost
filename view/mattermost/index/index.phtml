// The Swarm layout publishes the session token through the csrf() view helper
// (<body data-csrf="...">); use the same helper here, with the controller value as backup.
$csrfToken = (string) $this->csrfToken;
try {
    $csrfToken = (string) $this->csrf() ?: $csrfToken;
} catch (\Throwable $e) {
    // helper not available: keep the controller value, the page also reads <body data-csrf>
}
$settings = [
    'baseUrl'    => (string) $this->baseUrl,
    'apiVersion' => (string) $this->apiVersion,
    'configId'   => (string) $this->configId,
    'csrfToken'  => $csrfToken,
];
