        projectChannelsChannelsTitle: 'Channels',
        projectChannelsChannelsSubtitle: 'One or more Mattermost channel names (URL handles) or IDs to post notifications to for this project. The bot must be a member of each channel.',
        channelInputPlaceholder: 'Channel name or ID',
        channelInputHelperText: 'Separate several channels with commas',
