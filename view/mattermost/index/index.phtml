        notifyMentionedOnlyTitle: 'Notify Mentioned Only',
        notifyMentionedOnlySubtitle: 'Only notify users who are explicitly mentioned in a review.',
        notifyTitle: 'Notify',
        notifySubtitle: 'Select which user groups should receive Mattermost notifications for review events.',
        summaryFileLimitTitle: 'Summary File Limit',
        summaryFileLimitSubtitle: 'Maximum number of files to list in the Mattermost review summary.',
        userEnabledTitle: 'Custom Bot User',
        userEnabledSubtitle: 'Display Mattermost messages using a custom username and avatar instead of the bot account identity. Requires the username and profile picture override options to be enabled in the Mattermost System Console.',
        userNameTitle: 'Bot Display Name',
        userNameSubtitle: 'The name the bot uses when posting messages to Mattermost.',
        userIconTitle: 'Bot Avatar URL',
        userIconSubtitle: 'URL of the avatar image the bot uses when posting messages to Mattermost.',
        userForceUserHeaderTitle: 'Force User Header',
        userForceUserHeaderSubtitle: 'Force Mattermost to display the user header on every message instead of collapsing consecutive posts.',
        workspaceTooltipsEdit: 'Edit server configuration',
        workspaceTooltipsDelete: 'Delete this server',
        workspaceTooltipsCannotDelete: 'At least one server must remain configured',
        deleteWorkspaceConfirmTitle: 'Delete Server',
        deleteWorkspaceConfirmWarning: "Are you sure you want to delete the Mattermost server '{{workspaceId}}'?",
        deleteWorkspaceConfirmWarningSecond: 'This action cannot be undone.',
        workspaceSavedSuccess: 'Server saved successfully',
        workspaceDeletedSuccess: 'Server deleted successfully',
        workspaceDeleteError: 'Failed to delete server',
        loadError: 'Failed to load the Mattermost configuration',
        saveError: 'Failed to save server',
        noServers: 'No Mattermost servers configured yet.',
        csrfMissing: 'CSRF token not found on this page. Saving will fail until the token is available; see the module README.',
        edit: 'Edit',
        remove: 'Delete',
        cancel: 'Cancel',
        save: 'Save',
        loading: 'Loading...',
        colChannels: 'Project channels',
        colOptions: 'Options',
        tokenStored: 'stored'
    };

    var notifyOptions = [
        ['author', 'Author'],
        ['reviewers', 'Reviewers'],
        ['project_owners', 'Project owners'],
        ['project_members', 'Project members'],
        ['project_default_reviewers', 'Project default reviewers'],
        ['branch_default_reviewers', 'Branch default reviewers'],
        ['branch_moderators', 'Branch moderators']
    ];

    function t(key, vars) {
        var s = strings[key] !== undefined ? strings[key] : key;
        if (vars) {
            Object.keys(vars).forEach(function (k) {
                s = s.split('{{' + k + '}}').join(vars[k]);
            });
        }
        return s;
    }

    function el(tag, attrs, children) {
        var node = document.createElement(tag);
        if (attrs) {
            Object.keys(attrs).forEach(function (k) {
                if (k === 'text') {
                    node.textContent = attrs[k];
                } else if (k === 'class') {
                    node.className = attrs[k];
                } else if (k.indexOf('on') === 0 && typeof attrs[k] === 'function') {
                    node.addEventListener(k.substring(2), attrs[k]);
                } else if (attrs[k] === true) {
                    node.setAttribute(k, '');
                } else if (attrs[k] !== false && attrs[k] !== null && attrs[k] !== undefined) {
                    node.setAttribute(k, attrs[k]);
                }
            });
        }
        (children || []).forEach(function (c) {
            if (c === null || c === undefined) {
                return;
            }
            node.appendChild(typeof c === 'string' ? document.createTextNode(c) : c);
        });
        return node;
    }

    function applyStrings() {
        root.querySelectorAll('[data-i18n]').forEach(function (node) {
            node.textContent = t(node.getAttribute('data-i18n'));
        });
        document.getElementById('mm-cancel').textContent = t('cancel');
        document.getElementById('mm-save').textContent = t('save');
        document.getElementById('mm-confirm-cancel').textContent = t('cancel');
        document.getElementById('mm-confirm-ok').textContent = t('remove');
    }

    // ---- CSRF ---------------------------------------------------------------------
    function csrfToken() {
        if (settings.csrfToken) {
            return settings.csrfToken;
        }
        var meta = document.querySelector('meta[name="csrf-token"]');
        if (meta && meta.content) {
            return meta.content;
        }
        if (document.body && document.body.getAttribute('data-csrf')) {
            return document.body.getAttribute('data-csrf');
        }
        var candidates = [document.documentElement, document.body].concat(
            Array.prototype.slice.call(document.querySelectorAll('[data-csrf],[data-csrf-token]'))
        );
        for (var i = 0; i < candidates.length; i++) {
            var n = candidates[i];
            if (n && (n.getAttribute('data-csrf') || n.getAttribute('data-csrf-token'))) {
                return n.getAttribute('data-csrf') || n.getAttribute('data-csrf-token');
            }
        }
        if (window.swarm && window.swarm.csrf) {
            return window.swarm.csrf;
        }
        return '';
    }

    // ---- API ----------------------------------------------------------------------
    function api(path, method, body) {
        var headers = { 'Accept': 'application/json' };
        var token   = csrfToken();
        if (token) {
            headers['X-CSRF-TOKEN'] = encodeURIComponent(token);
        }
        if (body !== undefined) {
            headers['Content-Type'] = 'application/json';
        }
        return fetch(apiBase + path, {
            method: method || 'GET',
            credentials: 'same-origin',
            headers: headers,
            body: body !== undefined ? JSON.stringify(body) : undefined
        }).then(function (res) {
            return res.text().then(function (text) {
                var json = null;
                try { json = text ? JSON.parse(text) : null; } catch (e) { json = null; }
                if (!res.ok) {
                    var err = new Error(extractError(json) || (res.status + ' ' + res.statusText));
                    err.status = res.status;
                    err.payload = json;
                    throw err;
                }
                return json;
            });
        });
    }

    function flattenMessages(value, out, prefix) {
        if (value === null || value === undefined) {
            return out;
        }
        if (typeof value === 'string') {
            out.push(prefix ? prefix + ': ' + value : value);
        } else if (Array.isArray(value)) {
            value.forEach(function (v) { flattenMessages(v, out, prefix); });
        } else if (typeof value === 'object') {
            if (value.text || value.message) {
                out.push(prefix ? prefix + ': ' + (value.text || value.message) : (value.text || value.message));
                return out;
            }
            Object.keys(value).forEach(function (k) {
                flattenMessages(value[k], out, prefix ? prefix + '.' + k : k);
            });
        } else {
            out.push(String(value));
        }
        return out;
    }

    function extractError(json) {
        if (!json) {
            return '';
        }
        var out = [];
        if (json.messages) {
            flattenMessages(json.messages, out, '');
        }
        if (json.error && typeof json.error !== 'object') {
            out.unshift(String(json.error));
        } else if (json.error) {
            flattenMessages(json.error, out, '');
        }
        return out.join('\n');
    }

    // ---- State / rendering --------------------------------------------------------
    var workspaces = [];

    function notice(kind, message, sticky) {
        var box = document.getElementById('mm-notice');
        box.innerHTML = '';
        if (!message) {
            return;
        }
        var node = el('div', { class: 'mm-alert mm-alert-' + kind, text: message });
        box.appendChild(node);
        if (!sticky) {
            setTimeout(function () { if (node.parentNode) { node.parentNode.removeChild(node); } }, 5000);
        }
    }

    function toast(kind, message) {
        var node = el('div', { class: 'mm-alert mm-alert-' + kind + ' mm-toast', text: message });
        root.appendChild(node);
        setTimeout(function () { if (node.parentNode) { node.parentNode.removeChild(node); } }, 4000);
    }

    function load() {
        return api('').then(function (json) {
            var config = json && json.data && json.data.configurations ? json.data.configurations[0] : null;
            workspaces = ((config && config.workspaces) || []).filter(function (w) { return !w.isDeleted; });
            renderList();
        }).catch(function (e) {
            document.getElementById('mm-list').innerHTML = '';
            notice('error', t('loadError') + ': ' + e.message, true);
        });
    }

    function describeChannels(ws) {
        var rows = ws.projectChannels || [];
        if (!rows.length) {
            return [el('span', { class: 'mm-muted', text: '\u2014' })];
        }
        return rows.map(function (row) {
            return el('div', { class: 'mm-code' }, [
                (row.project || '') + ' \u2192 ' + (row.channels || []).join(', ')
            ]);
        });
    }

    function describeOptions(ws) {
        var chips = [];
        if (ws.summaryFileNames) { chips.push(t('summaryFileNamesTitle')); }
        if (ws.replyFileNames) { chips.push(t('replyFileNamesTitle')); }
        if (ws.bypassRestrictedChangelist) { chips.push(t('bypassRestrictedChangelistTitle')); }
        if (ws.notifyMentionedOnly) { chips.push(t('notifyMentionedOnlyTitle')); }
        (ws.notify || []).forEach(function (n) { chips.push('@' + n); });
        if (ws.user && ws.user.enabled && ws.user.name) { chips.push(ws.user.name); }
        return chips.map(function (c) { return el('span', { class: 'mm-chip', text: c }); });
    }

    function renderList() {
        var list = document.getElementById('mm-list');
        list.innerHTML = '';
        if (!workspaces.length) {
            list.appendChild(el('div', { class: 'mm-empty', text: t('noServers') }));
            return;
        }
        var canDelete = workspaces.length > 1;
        var table = el('table', null, [
            el('thead', null, [el('tr', null, [
                el('th', { text: t('workspaceIdTitle') }),
                el('th', { text: t('urlTitle') }),
                el('th', { text: t('teamTitle') }),
                el('th', { text: t('colChannels') }),
                el('th', { text: t('colOptions') }),
                el('th', { text: '' })
            ])]),
            el('tbody', null, workspaces.map(function (ws) {
                return el('tr', null, [
                    el('td', { class: 'mm-id' }, [el('strong', { text: ws.id || '' })]),
                    el('td', { class: 'mm-code' }, [ws.url || el('span', { class: 'mm-muted', text: '\u2014' })]),
                    el('td', { class: 'mm-code' }, [ws.team || el('span', { class: 'mm-muted', text: '\u2014' })]),
                    el('td', null, describeChannels(ws)),
                    el('td', null, describeOptions(ws)),
                    el('td', { class: 'mm-actions' }, [
                        el('button', {
                            type: 'button', class: 'mm-btn mm-btn-link', title: t('workspaceTooltipsEdit'),
                            text: t('edit'), onclick: function () { openEditor(ws); }
                        }),
                        el('button', {
                            type: 'button', class: 'mm-btn mm-btn-link mm-btn-danger',
                            title: canDelete ? t('workspaceTooltipsDelete') : t('workspaceTooltipsCannotDelete'),
                            disabled: !canDelete, text: t('remove'),
                            onclick: function () { confirmDelete(ws); }
                        })
                    ])
                ]);
            }))
        ]);
        list.appendChild(table);
    }

    // ---- Editor -------------------------------------------------------------------
    var editing = null; // null when creating

    function field(name, labelKey, hintKey, input) {
        return el('div', { class: 'mm-field', 'data-field': name }, [
            el('label', { class: 'mm-label', for: 'mm-f-' + name, text: t(labelKey) }),
            hintKey ? el('div', { class: 'mm-hint', text: t(hintKey) }) : null,
            input,
            el('div', { class: 'mm-error', 'data-error': name })
        ]);
    }

    function textInput(name, value, extra) {
        var attrs = { type: 'text', id: 'mm-f-' + name, name: name, value: value || '' };
        Object.keys(extra || {}).forEach(function (k) { attrs[k] = extra[k]; });
        return el('input', attrs);
    }

    function checkbox(name, labelKey, hintKey, checked) {
        var input = el('input', { type: 'checkbox', id: 'mm-f-' + name, name: name });
        input.checked = !!checked;
        return el('div', { class: 'mm-check' }, [
            input,
            el('div', null, [
                el('label', { for: 'mm-f-' + name, text: t(labelKey) }),
                hintKey ? el('div', { class: 'mm-hint', text: t(hintKey) }) : null
            ])
        ]);
    }

    function projectChannelRow(project, channels) {
        var row = el('div', { class: 'mm-pc-row' });
        row.appendChild(el('input', { type: 'text', 'data-pc': 'project', value: project || '', placeholder: t('projectChannelsProjectTitle') }));
        row.appendChild(el('input', { type: 'text', 'data-pc': 'channels', value: (channels || []).join(', '), placeholder: t('channelInputPlaceholder') }));
        row.appendChild(el('button', {
            type: 'button', class: 'mm-btn', title: t('removeProjectChannel'), text: '\u2715',
            onclick: function () { row.parentNode.removeChild(row); }
        }));
        return row;
    }

    function buildForm(ws) {
        var body = document.getElementById('mm-form-body');
        body.innerHTML = '';
        var isNew = !editing;
        var user  = ws.user || {};

        body.appendChild(field('id', 'workspaceIdTitle', 'workspaceIdSubtitle',
            textInput('id', ws.id, isNew ? {} : { readonly: true })));
        body.appendChild(field('url', 'urlTitle', 'urlSubtitle',
            textInput('url', ws.url, { placeholder: t('urlPlaceholder') })));
        body.appendChild(field('team', 'teamTitle', 'teamSubtitle',
            textInput('team', ws.team, { placeholder: t('teamPlaceholder') })));
        body.appendChild(field('token', 'tokenTitle', 'tokenSubtitle',
            el('input', {
                type: 'password', id: 'mm-f-token', name: 'token', autocomplete: 'new-password',
                placeholder: isNew ? '' : (ws.token ? '\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022 (' + t('tokenStored') + ') \u2014 ' + t('tokenKeep') : t('tokenKeep'))
            })));

        var pcSection = el('div', { class: 'mm-section' }, [
            el('h3', { text: t('projectChannelsTitle') }),
            el('div', { class: 'mm-hint', text: t('projectChannelsSubtitle') }),
            el('div', { class: 'mm-hint', text: t('projectChannelsProjectSubtitle') }),
            el('div', { class: 'mm-hint', text: t('projectChannelsChannelsSubtitle') + ' ' + t('channelInputHelperText') })
        ]);
        var pcList = el('div', { id: 'mm-pc-list' });
        (ws.projectChannels || []).forEach(function (row) {
            pcList.appendChild(projectChannelRow(row.project, row.channels));
        });
        pcSection.appendChild(pcList);
        pcSection.appendChild(el('div', { class: 'mm-error', 'data-error': 'projectChannels' }));
        pcSection.appendChild(el('button', {
            type: 'button', class: 'mm-btn', text: '+ ' + t('addProjectChannel'),
            onclick: function () { pcList.appendChild(projectChannelRow('', [])); }
        }));
        body.appendChild(pcSection);

        var opts = el('div', { class: 'mm-section' }, [
            checkbox('summaryFileNames', 'summaryFileNamesTitle', 'summaryFileNamesSubtitle', ws.summaryFileNames),
            checkbox('replyFileNames', 'replyFileNamesTitle', 'replyFileNamesSubtitle', ws.replyFileNames),
            checkbox('bypassRestrictedChangelist', 'bypassRestrictedChangelistTitle', 'bypassRestrictedChangelistSubtitle', ws.bypassRestrictedChangelist),
            checkbox('notifyMentionedOnly', 'notifyMentionedOnlyTitle', 'notifyMentionedOnlySubtitle', ws.notifyMentionedOnly),
            field('summaryFileLimit', 'summaryFileLimitTitle', 'summaryFileLimitSubtitle',
                el('input', { type: 'number', id: 'mm-f-summaryFileLimit', name: 'summaryFileLimit', min: 1, value: ws.summaryFileLimit || 10 }))
        ]);
        body.appendChild(opts);

        var notifyGrid = el('div', { class: 'mm-notify' });
        notifyOptions.forEach(function (opt) {
            var input = el('input', { type: 'checkbox', 'data-notify': opt[0], id: 'mm-n-' + opt[0] });
            input.checked = (ws.notify || []).indexOf(opt[0]) !== -1;
            notifyGrid.appendChild(el('div', { class: 'mm-check' }, [input, el('label', { for: 'mm-n-' + opt[0], text: opt[1] })]));
        });
        body.appendChild(el('div', { class: 'mm-section' }, [
            el('h3', { text: t('notifyTitle') }),
            el('div', { class: 'mm-hint', text: t('notifySubtitle') }),
            notifyGrid
        ]));

        body.appendChild(el('div', { class: 'mm-section' }, [
            checkbox('userEnabled', 'userEnabledTitle', 'userEnabledSubtitle', user.enabled !== undefined ? user.enabled : true),
            field('userName', 'userNameTitle', 'userNameSubtitle', textInput('userName', user.name !== undefined ? user.name : 'Helix Swarm')),
            field('userIcon', 'userIconTitle', 'userIconSubtitle', textInput('userIcon', user.icon)),
            checkbox('userForceUserHeader', 'userForceUserHeaderTitle', 'userForceUserHeaderSubtitle', user.forceUserHeader)
        ]));
    }

    function openEditor(ws) {
        editing = ws || null;
        document.getElementById('mm-dialog-title').textContent = t(ws ? 'modalEditTitle' : 'modalAddTitle');
        document.getElementById('mm-save').textContent = t(ws ? 'updateWorkspace' : 'addWorkspace');
        buildForm(ws || {
            summaryFileLimit: 10,
            notify: [],
            projectChannels: [],
            user: { enabled: true, name: 'Helix Swarm', icon: '', forceUserHeader: false }
        });
        document.getElementById('mm-dialog').showModal();
    }

    function val(name) {
        var node = document.getElementById('mm-f-' + name);
        return node ? node.value.trim() : '';
    }

    function checked(name) {
        var node = document.getElementById('mm-f-' + name);
        return !!(node && node.checked);
    }

    function setError(name, message) {
        var box = document.querySelector('[data-error="' + name + '"]');
        if (box) {
            box.textContent = message || '';
        }
        var input = document.getElementById('mm-f-' + name);
        if (input) {
            input.classList.toggle('mm-invalid', !!message);
        }
    }

    function collectForm() {
        var errors = 0;
        ['id', 'url', 'token', 'projectChannels', 'summaryFileLimit'].forEach(function (n) { setError(n, ''); });

        var isNew = !editing;
        var id    = val('id');
        var url   = val('url');
        var token = val('token');

        if (!id) { setError('id', t('workspaceIdRequired')); errors++; }
        if (isNew && workspaces.some(function (w) { return w.id === id; })) {
            setError('id', t('workspaceDuplicateName')); errors++;
        }
        if (!url) { setError('url', t('urlRequired')); errors++; }
        else if (!/^https?:\/\/[^\s\/]+/i.test(url)) { setError('url', t('urlInvalid')); errors++; }
        if (isNew && !token) { setError('token', t('tokenRequired')); errors++; }

        var projectChannels = [];
        var pcError = '';
        document.querySelectorAll('#mm-pc-list .mm-pc-row').forEach(function (row) {
            var project  = row.querySelector('[data-pc="project"]').value.trim();
            var channels = row.querySelector('[data-pc="channels"]').value.split(/[,\s]+/)
                .map(function (c) { return c.trim(); }).filter(Boolean);
            if (!project && !channels.length) {
                return; // ignore fully blank rows
            }
            if (!project) { pcError = t('projectRequired'); }
            else if (!channels.length) { pcError = t('channelsRequired'); }
            projectChannels.push({ project: project, channels: channels });
        });
        if (pcError) { setError('projectChannels', pcError); errors++; }

        var limit = parseInt(val('summaryFileLimit'), 10);
        if (isNaN(limit) || limit < 1) { setError('summaryFileLimit', t('summaryFileLimitTitle') + ' > 0'); errors++; }

        if (errors) {
            return null;
        }

        var notify = [];
        document.querySelectorAll('#mm-form-body [data-notify]').forEach(function (n) {
            if (n.checked) { notify.push(n.getAttribute('data-notify')); }
        });

        var payload = {
            id: id,
            url: url,
            team: val('team'),
            projectChannels: projectChannels,
            summaryFileNames: checked('summaryFileNames'),
            replyFileNames: checked('replyFileNames'),
            bypassRestrictedChangelist: checked('bypassRestrictedChangelist'),
            notifyMentionedOnly: checked('notifyMentionedOnly'),
            notify: notify,
            summaryFileLimit: limit,
            user: {
                enabled: checked('userEnabled'),
                name: val('userName'),
                icon: val('userIcon'),
                forceUserHeader: checked('userForceUserHeader')
            }
        };
        if (token) {
            payload.token = token; // blank token on edit means "keep the stored one"
        }
        return payload;
    }

    function save(event) {
        event.preventDefault();
        var payload = collectForm();
        if (!payload) {
            return;
        }
        var button = document.getElementById('mm-save');
        button.disabled = true;
        api('/workspaces/' + encodeURIComponent(payload.id), 'PATCH', payload).then(function () {
            document.getElementById('mm-dialog').close();
            toast('ok', t('workspaceSavedSuccess'));
            return load();
        }).catch(function (e) {
            var message = t('saveError') + ': ' + e.message;
            var box = document.getElementById('mm-form-body');
            var old = box.querySelector('.mm-alert');
            if (old) { old.parentNode.removeChild(old); }
            box.insertBefore(el('div', { class: 'mm-alert mm-alert-error', text: message }), box.firstChild);
            box.scrollTop = 0;
        }).then(function () {
            button.disabled = false;
        });
    }

    // ---- Delete -------------------------------------------------------------------
    var deleting = null;

    function confirmDelete(ws) {
        deleting = ws;
        document.getElementById('mm-confirm-title').textContent = t('deleteWorkspaceConfirmTitle');
        document.getElementById('mm-confirm-text').textContent = t('deleteWorkspaceConfirmWarning', { workspaceId: ws.id });
        document.getElementById('mm-confirm').showModal();
    }

    function doDelete() {
        if (!deleting) {
            return;
        }
        var id = deleting.id;
        document.getElementById('mm-confirm').close();
        api('/workspaces/' + encodeURIComponent(id), 'DELETE').then(function () {
            toast('ok', t('workspaceDeletedSuccess'));
            return load();
        }).catch(function (e) {
            notice('error', t('workspaceDeleteError') + ': ' + e.message, true);
        });
    }

    // ---- Translations -------------------------------------------------------------
    function loadStrings() {
        var lang = (document.documentElement.lang || navigator.language || 'en').toLowerCase().split(/[-_]/)[0];
        var langs = lang === 'en' ? ['en'] : [lang, 'en'];
        var chain = Promise.reject();
        langs.forEach(function (l) {
            chain = chain.catch(function () {
                return fetch(baseUrl + '/locales/' + l + '/configuration.json', { credentials: 'same-origin' })
                    .then(function (r) { if (!r.ok) { throw new Error(); } return r.json(); });
            });
        });
        return chain.then(function (json) {
            if (json && json.mattermost) {
                Object.keys(json.mattermost).forEach(function (k) {
                    if (typeof json.mattermost[k] === 'string') { strings[k] = json.mattermost[k]; }
                });
            }
        }).catch(function () { /* keep built-in English */ });
    }

    // ---- Boot ---------------------------------------------------------------------
    document.getElementById('mm-add').addEventListener('click', function () { openEditor(null); });
    document.getElementById('mm-form').addEventListener('submit', save);
    document.getElementById('mm-cancel').addEventListener('click', function () { document.getElementById('mm-dialog').close(); });
    document.getElementById('mm-confirm-cancel').addEventListener('click', function () { document.getElementById('mm-confirm').close(); });
    document.getElementById('mm-confirm-ok').addEventListener('click', doDelete);

    loadStrings().then(function () {
        applyStrings();
        if (!csrfToken()) {
            notice('warn', t('csrfMissing'), true);
        }
        return load();
    });
})();
</script>
